# Local development uses SQLite and uploads/ unless APP_ENV=production.
APP_ENV=development
SECRET_KEY=replace-with-a-random-value-at-least-32-characters

# Production-only values; use the Supabase project URL, PostgreSQL connection
# string, and server-side service-role key. Never commit real values.
DATABASE_URL=
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-server-side-service-role-key
SUPABASE_STORAGE_BUCKET=daywise-files
